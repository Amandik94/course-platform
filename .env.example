# --- Django ---
DJANGO_SECRET_KEY=replace-with-secure-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,.ngrok-free.dev,.ngrok-free.app

# --- PostgreSQL ---
