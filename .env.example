# --- Django ---
DJANGO_SECRET_KEY=replace-with-secure-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,.ngrok-free.dev,.ngrok-free.app

# --- PostgreSQL ---
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=replace-with-secure-password
DB_HOST=localhost
DB_PORT=5432

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- YooKassa test payments ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_TIMEOUT_SECONDS=15
PUBLIC_FRONTEND_URL=http://localhost
